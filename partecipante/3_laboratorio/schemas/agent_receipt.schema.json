{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$id": "urn:ingv:workflow-lab:agent-receipt:1.0",
  "title": "Immutable draft revision receipt 1.0",
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "request_id",
    "revision",
    "mode",
    "text_sha256",
    "outputs_sha256",
    "request_sha256",
    "mandate_sha256",
    "text_path",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "agent_receipt"
    },
    "run_id": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "agent",
        "manual"
      ]
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputs_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mandate_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text_path": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  }
}
