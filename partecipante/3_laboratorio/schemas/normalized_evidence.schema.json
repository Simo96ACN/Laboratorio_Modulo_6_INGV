{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ingv:workflow-lab:normalized-evidence:1.0",
  "title": "Normalized Evidence Record v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evidence_id",
    "dataset_id",
    "field",
    "value",
    "source_id",
    "source_path",
    "source_record_id",
    "observed_at",
    "authority_scope",
    "freshness",
    "status",
    "raw_hash",
    "normalization_version"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "normalized_evidence"},
    "evidence_id": {"type": "string", "minLength": 1},
    "dataset_id": {"type": "string", "pattern": "^DS-[0-9]{2}$"},
    "field": {"type": "string", "minLength": 1},
    "value": {},
    "source_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "authority_scope": {"type": "string", "minLength": 1},
    "freshness": {"enum": ["CURRENT", "STALE", "UNKNOWN"]},
    "status": {"enum": ["FACT", "PASS", "FAIL", "UNKNOWN", "CONFLICT", "INFORMATIONAL"]},
    "raw_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "normalization_version": {"type": "string", "minLength": 1}
  }
}
