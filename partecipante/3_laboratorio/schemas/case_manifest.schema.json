{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ingv:workflow-lab:case-manifest:1.0",
  "title": "Meridiano Workflow Lab Case Manifest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "case_id",
    "scenario_version",
    "title",
    "data_classification",
    "contains_real_personal_data",
    "as_of",
    "timezone",
    "release_at",
    "dataset_ids",
    "aliases",
    "thresholds",
    "required_approval_scopes",
    "source_families",
    "source_hashes",
    "policy"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "case_manifest"},
    "case_id": {"type": "string", "minLength": 1},
    "scenario_version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "data_classification": {"const": "synthetic_training_data"},
    "contains_real_personal_data": {"const": false},
    "as_of": {"type": "string", "format": "date-time"},
    "timezone": {"const": "Europe/Rome"},
    "release_at": {"type": "string", "format": "date-time"},
    "dataset_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DS-[0-9]{2}$"}
    },
    "aliases": {
      "type": "object",
      "minProperties": 15,
      "additionalProperties": {"type": "string", "pattern": "^DS-[0-9]{2}$"}
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_values_pct_max", "outlier_pct_max"],
      "properties": {
        "missing_values_pct_max": {"type": "number", "minimum": 0},
        "outlier_pct_max": {"type": "number", "minimum": 0}
      }
    },
    "required_approval_scopes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_families": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "urn:ingv:workflow-lab:raw-source-descriptor:1.0"}
    },
    "source_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_approval_required", "simulated_effects_only", "ai_may_authorize"],
      "properties": {
        "human_approval_required": {"const": true},
        "simulated_effects_only": {"const": true},
        "ai_may_authorize": {"const": false}
      }
    }
  }
}
