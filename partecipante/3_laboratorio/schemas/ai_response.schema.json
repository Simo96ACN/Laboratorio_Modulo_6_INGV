{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ingv:workflow-lab:ai-response:1.0",
  "title": "AI Response v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "response_id",
    "run_id",
    "request_id",
    "node_id",
    "prompt_hash",
    "payload_hash",
    "created_at",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "ai_response"},
    "response_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "node_id": {"const": "classify_evidence"},
    "prompt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "payload_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "outputs": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "label", "evidence_refs", "rationale", "uncertainties"],
        "properties": {
          "dataset_id": {"type": "string", "pattern": "^DS-[0-9]{2}$"},
          "label": {"enum": ["SAFE", "SENSITIVE", "UNKNOWN"]},
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "rationale": {"type": "string", "minLength": 1},
          "uncertainties": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
